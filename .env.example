# Proveedor de IA: "ollama" (local), "anthropic" o "gemini" (nube)
LLM_PROVIDER=ollama

# Ollama (local)
# 127.0.0.1 y no localhost: en Windows localhost agrega ~2 s de espera por IPv6
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Anthropic (nube). La key va SOLO en el .env real, nunca en git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini (nube). La key va SOLO en el .env real, nunca en git.
# Ojo: en el nivel gratuito Google puede usar el contenido para mejorar sus productos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

DB_PATH=data/turnos.db

TIMEZONE=America/Argentina/Buenos_Aires

# Estas dos son solo del proyecto pre-SaaS (single-tenant): ya no hace falta configurarlas.
# Cada negocio ahora se registra en /registro con su propio nombre, email y clave.
BUSINESS_NAME=
ADMIN_TOKEN=
