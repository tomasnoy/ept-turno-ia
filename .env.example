# Proveedor de IA: "ollama" (local) o "anthropic" (nube)
LLM_PROVIDER=ollama

# Ollama (local)
# 127.0.0.1 y no localhost: en Windows localhost agrega ~2 s de espera por IPv6
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Anthropic (nube). La key va SOLO en el .env real, nunca en git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

DB_PATH=data/turnos.db
