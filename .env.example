# Proveedor de IA: "ollama" (local) o "anthropic" (nube)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Anthropic (nube). La key va SOLO en el .env real, nunca en git.
ANTHROPIC_API_KEY=
